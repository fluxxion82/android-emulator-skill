# Local skill config (user-specific). The scripts/ path is where
# emulator_selector used to write recent-AVD history; the rule above it
# pointed at a path nothing ever wrote, so the real file was never ignored.
android-emulator-skill/skills/android-emulator-skill/config.json
android-emulator-skill/skills/android-emulator-skill/scripts/config.json

